{
  "name": "provence-agent-native",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native surface over the myProvence /les-guides clusters: nine WebMCP site tools plus a live Demand Mirror.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "node scripts/copy-data.mjs && next build",
    "start": "next start -p 3040",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "ingest": "tsx ingest/build-catalog.ts",
    "ingest:enrich": "tsx ingest/build-catalog.ts --enrich",
    "verify:artefacts": "tsx ingest/verify.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.100.0",
    "leaflet": "1.9.4",
    "next": "14.2.35",
    "next-intl": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/jest": "29.5.14",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.18",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
